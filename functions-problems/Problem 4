// Write a JavaScript program which iterates the integers from 1 to 100. 
// Print "Fizz" instead of the number 3 
// Print “Buzz” instead of the number 5 
// Print “Fizz Buzz” for numbers which are multiples of both 3 and 5 

function fizzBuzz(){
  for(let i = 1; i <= 100; i++){
    let phrase = "";
    if(i % 3 === 0){
      phrase += "Fizz";
    }
    if (i % 5 ===0){                    
      phrase += "Buzz";
    }

    console.log(i, phrase);  
  }
}

fizzBuzz();
