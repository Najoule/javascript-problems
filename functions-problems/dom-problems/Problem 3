/*Steps: 
	1. Write a function that accepts a string and letter as a parameter to count a specific letter
 	2. Declare and assign variables “let” & “const” to “letterCount” and “arrayOfLetters” 
	4. Use a “for loop” to perform repeatedly over elements “arrayOfLetters.length” and method “charAt()” to find a specific letter and how many times it occurs 
	5. If statement is true, return vowel count*/ 


function findLetterCount(str, letter){
  let letterCount = 0;
  const arrOfLetters = str.toLowerCase().split("");

 /*Word Count
    What: 0, exactly: 1, are: 2, we: 3, counting: 4 

Letter “t” Count
     What: 1, exactly: 1, are: 0, we: 0, counting: 1 
     [1, 1, 1], the number of occurrences of the value t is 3.
*/
  
  for(let i = 0; i < arrOfLetters.length; i++){
    if(arrOfLetters[i].charAt() == letter){
      letterCount += 1;
    }
  }
  
  return letterCount;
}
